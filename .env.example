# ==========================================================
# APLICACAO
# ==========================================================
APP_NAME="AxysAI - Respostas para suas dúvidas"
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=troque-esta-chave-por-um-valor-aleatorio-seguro
API_HOST=0.0.0.0
API_PORT=8000
# Origens permitidas para CORS, separadas por virgula
CORS_ORIGINS=http://localhost:8501,http://localhost:8000

# ==========================================================
# BANCO DE DADOS
# ==========================================================
# SQLite no desenvolvimento; troque por uma URL PostgreSQL em producao
DATABASE_URL=sqlite:///./data/app.db

# ==========================================================
# PROVEDOR DE MODELO DE LINGUAGEM (LLM)
# ==========================================================
# Valores aceitos: anthropic | openai | ollama | gemini
LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Obtenha em https://aistudio.google.com/apikey (camada gratuita disponivel)
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Modelo usado pelo provedor selecionado acima
# gemini-flash-lite-latest: bem mais margem de requisicoes no plano gratuito
# que o gemini-flash-latest (Flash) — cerca de 4x o limite diario e 50% a
# mais por minuto (ver CHANGELOG). Troca de qualidade por cota, aceitavel
# para este caso de uso (responder com base em contexto ja recuperado).
LLM_MODEL=gemini-flash-lite-latest
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=180
# Quantas vezes o cliente HTTP tenta de novo sozinho antes de desistir.
# Baixo de proposito: com cota por minuto esgotada (comum no free tier do
# Gemini), cada retry so piora o problema (mais uma chamada contra a mesma
# janela ja estourada).
LLM_MAX_RETRIES=2
# Limite GLOBAL (nao por usuario) de chamadas ao provedor de LLM por minuto
# — protege a cota real do provedor (ex: Gemini free tier, ~15 req/min
# compartilhada pelo projeto inteiro). Um pouco abaixo da cota real de
# proposito, para sobrar margem. 0 desliga (nao recomendado com Gemini free tier).
LLM_RATE_LIMIT_PER_MINUTE=12
# Reaproveita a resposta ja gerada quando a mesma pergunta (normalizada) e
# feita de novo sobre o mesmo contexto recuperado — pula a chamada ao
# provedor por completo (nao gasta cota). Seguro por padrao: a chave do
# cache muda automaticamente se o conteudo dos documentos mudar.
LLM_ANSWER_CACHE_ENABLED=true
# Teto DIARIO (nao por minuto) de chamadas ao provedor, persistido no banco
# (sobrevive a reinicios do processo, diferente do limite por minuto acima).
# 0 desliga — o numero exato varia por modelo/conta, confira o seu em
# https://aistudio.google.com/apikey (pagina de cota) antes de ativar.
LLM_DAILY_REQUEST_LIMIT=0
# Quanto tempo (formato Ollama: 5m, 30m, 1h, -1 para sempre) o modelo fica
# carregado na memoria apos o ultimo uso. Evita recarregar do disco a cada
# pergunta (grande impacto na velocidade quando rodando em CPU).
OLLAMA_KEEP_ALIVE=30m

# ==========================================================
# PROVEDOR DE EMBEDDINGS
# ==========================================================
# Valores aceitos: sentence_transformers | openai | ollama
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIMENSION=768

# ==========================================================
# RERANKING
# ==========================================================
# Valores aceitos: cross_encoder | heuristic
RERANKER_PROVIDER=cross_encoder
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_CANDIDATES=20
RERANK_TOP_K=3
# Score minimo (0-1) apos o reranking para contar como evidencia real —
# abaixo disso, o agente trata como "nenhum documento encontrado" e cai no
# modo de conhecimento geral (ver SYSTEM_PROMPT).
RERANK_MIN_SCORE=0.3

# ==========================================================
# BANCO VETORIAL
# ==========================================================
# Valores aceitos hoje: chroma (arquitetura preparada para pgvector/qdrant/pinecone/weaviate)
VECTOR_STORE_PROVIDER=chroma
VECTOR_STORE_PATH=./data/vector_store
VECTOR_STORE_COLLECTION=documents

# ==========================================================
# CHUNKING
# ==========================================================
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_CHUNK_SIZE=1200

# ==========================================================
# BUSCA HIBRIDA
# ==========================================================
HYBRID_SEARCH_ENABLED=true
HYBRID_FUSION_STRATEGY=rrf
HYBRID_RRF_K=60

# ==========================================================
# INGESTAO / UPLOAD
# ==========================================================
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.docx,.xlsx,.pptx,.md,.csv,.json,.html,.htm
WATCHED_FOLDER_PATH=
WATCHED_FOLDER_ENABLED=false

# ==========================================================
# OCR
# ==========================================================
OCR_ENABLED=true
OCR_LANGUAGE=por+eng
# Caminho do binario do Tesseract (necessario no Windows caso nao esteja no PATH)
TESSERACT_CMD=

# ==========================================================
# LOGGING / OBSERVABILIDADE
# ==========================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=./data/logs

# ==========================================================
# LIMITACAO DE REQUISICOES
# ==========================================================
# Padrao generoso, pensado para desenvolvimento/demo com varios testers
# clicando rapido na interface (cada rerender do Streamlit pode disparar
# multiplas chamadas). Em producao, considere reduzir (ex: 60-120) conforme
# o numero real de usuarios simultaneos esperado.
RATE_LIMIT_PER_MINUTE=300

# ==========================================================
# AGENTE RAG
# ==========================================================
MAX_CONTEXT_CHARS=3000
MAX_CHAT_HISTORY_TURNS=6

# ==========================================================
# CURADORIA
# ==========================================================
# Sistema de uso livre, sem login/administrador dedicado (ver README) —
# quando true, um documento e aprovado automaticamente assim que termina de
# ser processado (a mesma transicao de estado e auditoria da aprovacao
# manual, so que sem esperar um clique). A pagina de Curadoria continua
# disponivel para quem quiser revisar/rejeitar manualmente; ninguem e
# obrigado a usa-la. Desligue (false) se quiser exigir revisao manual antes
# de um documento responder por perguntas.
AUTO_APPROVE_ON_UPLOAD=true

# ==========================================================
# INTERFACE STREAMLIT (frontend)
# ==========================================================
# URL onde a API FastAPI (backend) esta rodando. A interface Streamlit
# nunca acessa o banco de dados diretamente — consome exclusivamente a API.
API_BASE_URL=http://localhost:8000
