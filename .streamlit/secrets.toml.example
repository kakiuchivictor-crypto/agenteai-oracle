# Copie o conteudo deste arquivo para a secao "Secrets" do app no Streamlit
# Community Cloud (Settings > Secrets), com os valores reais. Nao commite um
# secrets.toml de verdade — o .gitignore ja bloqueia isso.

APP_ENV = "production"
APP_SECRET_KEY = "troque-por-um-valor-aleatorio-seguro"

LLM_PROVIDER = "gemini"
GEMINI_API_KEY = "sua-chave-aqui"
LLM_MODEL = "gemini-flash-lite-latest"

# Opcional: baixe a cota diaria/por-minuto se o app for usado por varias
# pessoas ao mesmo tempo no free tier do Gemini.
LLM_RATE_LIMIT_PER_MINUTE = 12
LLM_DAILY_REQUEST_LIMIT = 0
